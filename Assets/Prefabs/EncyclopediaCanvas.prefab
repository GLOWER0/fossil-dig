--- !u!114 &6894769969146649332
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1531566075603620703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61d1aa65ecfc8443b90157a77641b633, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fossilNumberText: {fileID: 6396432660461650545}
  fossilNameText: {fileID: 1496123313415412210}
  fossilPeriodText: {fileID: 1628406362838481215}
  fossilDescriptionText: {fileID: 931879895069848524}
  fossilImage: {fileID: 2372013751918927179}
  imagePlaceholder: {fileID: 4532812442585639588}
  pageCounterText: {fileID: 1659657190468121947}
  prevButton: {fileID: 9032466260377265346}
  nextButton: {fileID: 3769191492588852299}
  closeButton: {fileID: 298278633542937833}
  fossils:
  - fossilName: "\uC0AC\uC2B4\uBFD4 \uBF08"
    period: "\uC2E0\uC0DD\uB300 \uC81C4\uAE30 \xB7 \uC57D 1\uB9CC \uB144 \uC804"
    description: "\uBE59\uD558\uAE30 \uB9D0\uAE30\uC5D0 \uC11C\uC2DD\uD588\uB358
      \uAC70\uB300 \uC0AC\uC2B4\uC758 \uBFD4 \uD654\uC11D. \uB9E4\uB144 \uC790\uB77C\uACE0
      \uB5A8\uC5B4\uC9C0\uAE30\uB97C \uBC18\uBCF5\uD558\uB294 \uBFD4\uC774 \uC6B4
      \uC88B\uAC8C \uD1F4\uC801\uCE35\uC5D0 \uBB3B\uD600 \uD654\uC11D\uD654\uB41C
      \uAC83\uC774\uB2E4. \uB2E8\uB2E8\uD55C \uACE8\uC9C8 \uD45C\uBA74\uC5D0\uB294
      \uB098\uC774\uD14C\uCC98\uB7FC \uC131\uC7A5\uC120\uC774 \uB0A8\uC544\uC788\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uD55C\uBC18\uB3C4 \uBC0F \uB3D9\uBD81\uC544\uC2DC\uC544 \uC232\n\uBD84\uB958:
      \uC6B0\uC81C\uBAA9 \uC0AC\uC2B4\uACFC\n\uD06C\uAE30: \uBFD4 \uAE38\uC774 \uC57D
      60cm\n\uD2B9\uC9D5: \uC9DD\uC9D3\uAE30 \uCCA0\uC5D0 \uC218\uCEF7\uB07C\uB9AC\uC758
      \uACBD\uC7C1 \uB3C4\uAD6C"
    fossilImage: {fileID: 0}
  - fossilName: "\uC0B0\uD638 \uD654\uC11D"
    period: "\uC911\uC0DD\uB300 \uD2B8\uB77C\uC774\uC544\uC2A4\uAE30 \xB7 \uC57D
      2\uC5B5 3\uCC9C\uB9CC \uB144 \uC804"
    description: "\uC9C0\uAE08\uC740 \uC232\uC774 \uB41C \uC774 \uB545\uC774 \uD55C\uB54C
      \uB530\uB73B\uD55C \uC595\uC740 \uBC14\uB2E4\uC600\uC74C\uC744 \uC99D\uC5B8\uD558\uB294
      \uD654\uC11D. \uBBF8\uC138\uD55C \uAD6C\uBA4D\uB4E4\uC774 \uBE7C\uACE1\uD788
      \uBC15\uD78C \uAD6C\uC870\uC5D0\uC11C \uAD70\uCCB4 \uC0B0\uD638\uC784\uC744
      \uC54C \uC218 \uC788\uB2E4. \uBC1C\uACAC \uC9C0\uC810\uC774 \uD574\uBC1C \uC218\uBC31
      \uBBF8\uD130\uC778 \uC810\uC774 \uC9C0\uAC01 \uBCC0\uB3D9\uC758 \uC704\uB825\uC744
      \uBCF4\uC5EC\uC900\uB2E4.\n\n\uC11C\uC2DD\uC9C0: \uACE0\uB300 \uB530\uB73B\uD55C
      \uC595\uC740 \uBC14\uB2E4\n\uBD84\uB958: \uC790\uD3EC\uB3D9\uBB3C \uC0B0\uD638\uCDA9\uAC15\n\uD06C\uAE30:
      \uAD70\uCCB4 \uC9C1\uACBD \uC57D 15cm\n\uD2B9\uC9D5: \uC0B0\uD638\uCD08\uC758
      \uC870\uAC01, \uB2E4\uB978 \uD574\uC591 \uC0DD\uBB3C \uD654\uC11D\uACFC \uD568\uAED8
      \uBC1C\uACAC\uB428"
    fossilImage: {fileID: 0}
  - fossilName: "\uC0BC\uC5FD\uCDA9"
    period: "\uACE0\uC0DD\uB300 \uCE84\uBE0C\uB9AC\uC544\uAE30 \xB7 \uC57D 5\uC5B5
      \uB144 \uC804"
    description: "\uC9C0\uAD6C\uC0C1\uC5D0 \uCC98\uC74C \uB4F1\uC7A5\uD55C \uBCF5\uC7A1\uD55C
      \uC808\uC9C0\uB3D9\uBB3C \uC911 \uD558\uB098. \uBA38\uB9AC, \uAC00\uC2B4, \uAF2C\uB9AC
      \uC138 \uBD80\uBD84\uC73C\uB85C \uB098\uB25C \uC678\uACE8\uACA9\uC774 \uC774\uB984\uC758
      \uC720\uB798\uC774\uB2E4. \uC0AC\uB9C9\uC758 \uBAA8\uB798 \uC544\uB798\uC5D0
      \uB0A8\uC740 \uC774 \uD654\uC11D\uC740 \uC774\uACF3\uC774 \uD55C\uB54C \uBC14\uB2E4\uC600\uC74C\uC744
      \uC54C\uB824\uC900\uB2E4.\n\n\uC11C\uC2DD\uC9C0: \uACE0\uB300 \uC595\uC740
      \uBC14\uB2E4 \uBC14\uB2E5\n\uBD84\uB958: \uC808\uC9C0\uB3D9\uBB3C \uC0BC\uC5FD\uCDA9\uAC15\n\uD06C\uAE30:
      \uC57D 3~10cm\n\uD2B9\uC9D5: \uC9C0\uC9C8 \uC2DC\uB300\uB97C \uAD6C\uBD84\uD558\uB294
      \uD45C\uC900 \uD654\uC11D"
    fossilImage: {fileID: 0}
  - fossilName: "\uBB3C\uACE0\uAE30 \uD654\uC11D"
    period: "\uC911\uC0DD\uB300 \uBC31\uC545\uAE30 \xB7 \uC57D 1\uC5B5 \uB144 \uC804"
    description: "\uC644\uC804\uD55C \uACE8\uACA9\uC774 \uBCF4\uC874\uB41C \uACE0\uB300
      \uC5B4\uB958 \uD654\uC11D. \uBA38\uB9AC\uBD80\uD130 \uAF2C\uB9AC\uC9C0\uB290\uB7EC\uBBF8\uAE4C\uC9C0
      \uCC99\uCD94\uBF08\uAC00 \uB610\uB837\uC774 \uB0A8\uC544\uC788\uB2E4. \uC0AC\uB9C9
      \uD55C\uAC00\uC6B4\uB370\uC11C \uBC1C\uACAC\uB418\uC5C8\uC9C0\uB9CC, \uC774
      \uC77C\uB300\uAC00 \uBC31\uC545\uAE30\uC5D0\uB294 \uAC70\uB300\uD55C \uB0B4\uD574\uC600\uC74C\uC744
      \uBCF4\uC5EC\uC8FC\uB294 \uC99D\uAC70\uB2E4.\n\n\uC11C\uC2DD\uC9C0: \uBC31\uC545\uAE30
      \uB0B4\uD574\n\uBD84\uB958: \uACBD\uACE8\uC5B4\uAC15\n\uD06C\uAE30: \uC57D
      25cm\n\uD2B9\uC9D5: \uBE44\uB298 \uC790\uAD6D\uACFC \uC9C0\uB290\uB7EC\uBBF8
      \uD754\uC801\uAE4C\uC9C0 \uC120\uBA85\uD788 \uB0A8\uC74C"
    fossilImage: {fileID: 0}
  - fossilName: "\uD2B8\uB9AC\uCF00\uB77C\uD1B1\uC2A4 \uBA38\uB9AC\uBF08"
    period: "\uC911\uC0DD\uB300 \uBC31\uC545\uAE30 \uD6C4\uAE30 \xB7 \uC57D 6,700\uB9CC
      \uB144 \uC804"
    description: "\uC138 \uAC1C\uC758 \uBFD4\uACFC \uAC70\uB300\uD55C \uBAA9 \uBC29\uD328\uAC00
      \uD2B9\uC9D5\uC778 \uCD08\uC2DD \uACF5\uB8E1\uC758 \uB450\uAC1C\uACE8. \uCF54
      \uC704 \uC9E7\uC740 \uBFD4 \uD558\uB098\uC640 \uB208 \uC704\uB85C \uBED7\uC740
      \uAE34 \uBFD4 \uB450 \uAC1C\uAC00 \uB610\uB837\uC774 \uBCF4\uC874\uB418\uC5B4
      \uC788\uB2E4. \uB2E8\uB2E8\uD55C \uBD80\uB9AC\uB294 \uAC70\uCE5C \uC2DD\uBB3C\uC744
      \uC798\uB77C\uB0B4\uB294 \uB370 \uC4F0\uC600\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uBC31\uC545\uAE30 \uD6C4\uAE30 \uBD81\uC544\uBA54\uB9AC\uCE74 \uD3C9\uC6D0\n\uBD84\uB958:
      \uAC01\uB8E1\uB958 \uACF5\uB8E1\n\uD06C\uAE30: \uBA38\uB9AC\uBF08 \uAE38\uC774
      \uC57D 2m\n\uD2B9\uC9D5: \uCC9C\uC801 \uD2F0\uB77C\uB178\uC0AC\uC6B0\uB8E8\uC2A4\uC640\uC758
      \uC2F8\uC6C0\uC5D0\uC11C \uBFD4\uC774 \uBD80\uB7EC\uC9C4 \uD754\uC801 \uBC1C\uACAC\uB428"
    fossilImage: {fileID: 0}
  - fossilName: "\uC54C\uB85C\uC0AC\uC6B0\uB8E8\uC2A4 \uBA38\uB9AC\uBF08"
    period: "\uC911\uC0DD\uB300 \uC950\uB77C\uAE30 \uD6C4\uAE30 \xB7 \uC57D 1\uC5B5
      5\uCC9C\uB9CC \uB144 \uC804"
    description: "\uC950\uB77C\uAE30 \uC2DC\uB300 \uCD5C\uC0C1\uC704 \uD3EC\uC2DD\uC790\uC758
      \uB450\uAC1C\uACE8. \uC881\uACE0 \uAE34 \uC8FC\uB465\uC774\uC5D0 \uD1B1\uB2C8
      \uBAA8\uC591\uC758 \uB0A0\uCE74\uB85C\uC6B4 \uC774\uBE68\uC774 \uBE7C\uACE1\uD788
      \uBC15\uD600\uC788\uB2E4. \uB208 \uC704\uC5D0 \uB3CC\uCD9C\uB41C \uC791\uC740
      \uBFD4 \uAC19\uC740 \uC735\uAE30\uAC00 \uC885\uC744 \uC2DD\uBCC4\uD558\uB294
      \uD2B9\uC9D5\uC774\uB2E4.\n\n\uC11C\uC2DD\uC9C0: \uC950\uB77C\uAE30 \uD6C4\uAE30
      \uBD81\uC544\uBA54\uB9AC\uCE74 \uD3C9\uC6D0\n\uBD84\uB958: \uC218\uAC01\uB958
      \uACF5\uB8E1\n\uD06C\uAE30: \uBA38\uB9AC\uBF08 \uAE38\uC774 \uC57D 90cm\n\uD2B9\uC9D5:
      \uBB34\uB9AC \uC0AC\uB0E5\uC758 \uD754\uC801\uC774 \uD568\uAED8 \uBC1C\uACAC\uB41C
      \uD654\uC11D\uC9C0 \uC874\uC7AC"
    fossilImage: {fileID: 0}
  - fossilName: "\uC870\uAC1C \uD654\uC11D"
    period: "\uACE0\uC0DD\uB300 \uB370\uBCF8\uAE30 \xB7 \uC57D 4\uC5B5 \uB144 \uC804"
    description: "\uC591\uCABD \uAECD\uB370\uAE30\uAC00 \uB2EB\uD78C \uC0C1\uD0DC\uB85C
      \uBCF4\uC874\uB41C \uC644\uC804 \uD654\uC11D. \uD45C\uBA74\uC758 \uBC29\uC0AC\uD615
      \uBB34\uB2AC\uAC00 \uB69C\uB837\uD558\uB2E4. \uD611\uACE1\uC758 \uAE4A\uC740
      \uC9C0\uCE35\uC5D0\uC11C \uBC1C\uACAC\uB41C \uC774 \uD654\uC11D\uC740, \uC0B0\uC774
      \uC19F\uC544\uC624\uB974\uAE30 \uC804 \uC774\uACF3\uC774 \uAE4A\uC740 \uBC14\uB2E4
      \uBC11\uC774\uC5C8\uC74C\uC744 \uC99D\uC5B8\uD55C\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uACE0\uB300 \uAE4A\uC740 \uBC14\uB2E4 \uBC14\uB2E5\n\uBD84\uB958: \uC774\uB9E4\uD328\uAC15\n\uD06C\uAE30:
      \uC9C1\uACBD \uC57D 7cm\n\uD2B9\uC9D5: \uAECD\uB370\uAE30 \uB450 \uCABD\uC774
      \uBAA8\uB450 \uBCF4\uC874\uB41C \uC644\uC804\uCCB4"
    fossilImage: {fileID: 0}
  faceCamera: 1
  openDuration: 0.8
