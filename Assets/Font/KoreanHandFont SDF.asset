uC5D4\uC5EC\uC5ED\uC5F0\uC5F4\uC5FD\uC600\uC601\uC608\uC61B\uC624\uC628\uC62C\uC634\uC635\uC640\uC644\uC654\uC655\uC65C\uC678\uC6B0\uC6B4\uC6B8\uC6C0\uC6C5\uC6CC\uC6D0\uC704\uC720\uC721\uC728\uC735\uC73C\uC740\uC744\uC74C\uC758\uC774\uC775\uC778\uC77C\uC784\uC785\uC788\uC78E\uC790\uC791\uC794\uC798\uC7A0\uC7A1\uC7A5\uC7AC\uC7C1\uC800\uC801\uC804\uC808\uC80A\uC810\uC811\uC815\uC816\uC81C\uC838\uC870\uC871\uC874\uC878\uC881\uC885\uC88B\uC88C\uC8C4\uC8FC\uC8FD\uC900\uC911\uC950\uC988\uC989\uC990\uC99D\uC9C0\uC9C1\uC9C4\uC9C8\uC9D0\uC9D1\uC9D3\uC9D5\uC9D9\uC9DD\uC9E7\uCABD\uCC0C\uCC0D\uCC28\uCC29\uCC2C\uCC38\uCC3D\uCC3E\uCC44\uCC45\uCC98\uCC99\uCC9C\uCCA0\uCCA9\uCCAB\uCCAD\uCCB4\uCD08\uCD09\uCD1B\uCD1D\uCD5C\uCD94\uCD9C\uCDA9\uCE21\uCE35\uCE58\uCE5C\uCE68\uCE74\uCE7C\uCEE4\uCEE8\uCEEC\uCEF7\uCF1C\uCF54\uCF58\uCF5C\uD06C\uD070\uD07C\uD0A4\uD0C0\uD0C1\uD0C4\uD0D1\uD0D5\uD0DC\uD130\uD131\uD145\uD14C\uD154\uD1B1\uD1B5\uD1F4\uD22C\uD234\uD2B8\uD2B9\uD2BC\uD2BF\uD2C0\uD2C8\uD2F0\uD300\uD30C\uD328\uD3B4\uD3B8\uD3C9\uD3EC\uD3ED\uD45C\uD478\uD488\uD48D\uD504\uD50C\uD53C\uD53D\uD544\uD551\uD558\uD559\uD55C\uD560\uD568\uD569\uD56D\uD574\uD575\uD584\uD589\uD5A5\uD5C8\uD5CC\uD5D8\uD600\uD601\uD604\uD611\uD615\uD61C\uD638\uD639\uD640\uD654\uD655\uD658\uD669\uD68C\uD69F\uD6A8\uD6C4\uD6D4\uD718\uD734\uD750\uD754\uD758\uD759\uD76C\uD770\uD788\uD78C\uD798\uC0AC\uC2B4\uBFD4
      \uBF08\n\uC2E0\uC0DD\uB300 \uC81C4\uAE30 \xB7 \uC57D 1\uB9CC \uB144 \uC804\n\uBE59\uD558\uAE30
      \uB9D0\uAE30\uC5D0 \uC11C\uC2DD\uD588\uB358 \uAC70\uB300 \uC0AC\uC2B4\uC758
      \uBFD4 \uD654\uC11D. \uB9E4\uB144 \uC790\uB77C\uACE0 \uB5A8\uC5B4\uC9C0\uAE30\uB97C
      \uBC18\uBCF5\uD558\uB294 \uBFD4\uC774 \uC6B4 \uC88B\uAC8C \uD1F4\uC801\uCE35\uC5D0
      \uBB3B\uD600 \uD654\uC11D\uD654\uB41C \uAC83\uC774\uB2E4. \uB2E8\uB2E8\uD55C
      \uACE8\uC9C8 \uD45C\uBA74\uC5D0\uB294 \uB098\uC774\uD14C\uCC98\uB7FC \uC131\uC7A5\uC120\uC774
      \uB0A8\uC544\uC788\uB2E4.\n\uC11C\uC2DD\uC9C0: \uD55C\uBC18\uB3C4 \uBC0F \uB3D9\uBD81\uC544\uC2DC\uC544
      \uC232\n\uBD84\uB958: \uC6B0\uC81C\uBAA9 \uC0AC\uC2B4\uACFC\n\uD06C\uAE30:
      \uBFD4 \uAE38\uC774 \uC57D 60cm\n\uD2B9\uC9D5: \uC9DD\uC9D3\uAE30 \uCCA0\uC5D0
      \uC218\uCEF7\uB07C\uB9AC\uC758 \uACBD\uC7C1 \uB3C4\uAD6C\n\uC0B0\uD638 \uD654\uC11D\n\uC911\uC0DD\uB300
      \uD2B8\uB77C\uC774\uC544\uC2A4\uAE30 \xB7 \uC57D 2\uC5B5 3\uCC9C\uB9CC \uB144
      \uC804\n\uC9C0\uAE08\uC740 \uC232\uC774 \uB41C \uC774 \uB545\uC774 \uD55C\uB54C
      \uB530\uB73B\uD55C \uC595\uC740 \uBC14\uB2E4\uC600\uC74C\uC744 \uC99D\uC5B8\uD558\uB294
      \uD654\uC11D. \uBBF8\uC138\uD55C \uAD6C\uBA4D\uB4E4\uC774 \uBE7C\uACE1\uD788
      \uBC15\uD78C \uAD6C\uC870\uC5D0\uC11C \uAD70\uCCB4 \uC0B0\uD638\uC784\uC744
      \uC54C \uC218 \uC788\uB2E4. \uBC1C\uACAC \uC9C0\uC810\uC774 \uD574\uBC1C \uC218\uBC31
      \uBBF8\uD130\uC778 \uC810\uC774 \uC9C0\uAC01 \uBCC0\uB3D9\uC758 \uC704\uB825\uC744
      \uBCF4\uC5EC\uC900\uB2E4.\n\uC11C\uC2DD\uC9C0: \uACE0\uB300 \uB530\uB73B\uD55C
      \uC595\uC740 \uBC14\uB2E4\n\uBD84\uB958: \uC790\uD3EC\uB3D9\uBB3C \uC0B0\uD638\uCDA9\uAC15\n\uD06C\uAE30:
      \uAD70\uCCB4 \uC9C1\uACBD \uC57D 15cm\n\uD2B9\uC9D5: \uC0B0\uD638\uCD08\uC758
      \uC870\uAC01, \uB2E4\uB978 \uD574\uC591 \uC0DD\uBB3C \uD654\uC11D\uACFC \uD568\uAED8
      \uBC1C\uACAC\uB428\n\uC0BC\uC5FD\uCDA9\n\uACE0\uC0DD\uB300 \uCE84\uBE0C\uB9AC\uC544\uAE30
      \xB7 \uC57D 5\uC5B5 \uB144 \uC804\n\uC9C0\uAD6C\uC0C1\uC5D0 \uCC98\uC74C \uB4F1\uC7A5\uD55C
      \uBCF5\uC7A1\uD55C \uC808\uC9C0\uB3D9\uBB3C \uC911 \uD558\uB098. \uBA38\uB9AC,
      \uAC00\uC2B4, \uAF2C\uB9AC \uC138 \uBD80\uBD84\uC73C\uB85C \uB098\uB25C \uC678\uACE8\uACA9\uC774
      \uC774\uB984\uC758 \uC720\uB798\uC774\uB2E4. \uC0AC\uB9C9\uC758 \uBAA8\uB798
      \uC544\uB798\uC5D0 \uB0A8\uC740 \uC774 \uD654\uC11D\uC740 \uC774\uACF3\uC774
      \uD55C\uB54C \uBC14\uB2E4\uC600\uC74C\uC744 \uC54C\uB824\uC900\uB2E4.\n\uC11C\uC2DD\uC9C0:
      \uACE0\uB300 \uC595\uC740 \uBC14\uB2E4 \uBC14\uB2E5\n\uBD84\uB958: \uC808\uC9C0\uB3D9\uBB3C
      \uC0BC\uC5FD\uCDA9\uAC15\n\uD06C\uAE30: \uC57D 3~10cm\n\uD2B9\uC9D5: \uC9C0\uC9C8
      \uC2DC\uB300\uB97C \uAD6C\uBD84\uD558\uB294 \uD45C\uC900 \uD654\uC11D\n\uBB3C\uACE0\uAE30
      \uD654\uC11D\n\uC911\uC0DD\uB300 \uBC31\uC545\uAE30 \xB7 \uC57D 1\uC5B5 \uB144
      \uC804\n\uC644\uC804\uD55C \uACE8\uACA9\uC774 \uBCF4\uC874\uB41C \uACE0\uB300
      \uC5B4\uB958 \uD654\uC11D. \uBA38\uB9AC\uBD80\uD130 \uAF2C\uB9AC\uC9C0\uB290\uB7EC\uBBF8\uAE4C\uC9C0
