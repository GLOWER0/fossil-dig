--- !u!114 &6894769969146649332
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1531566075603620703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61d1aa65ecfc8443b90157a77641b633, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fossilNumberText: {fileID: 6396432660461650545}
  fossilNameText: {fileID: 1496123313415412210}
  fossilPeriodText: {fileID: 1628406362838481215}
  fossilDescriptionText: {fileID: 931879895069848524}
  fossilImage: {fileID: 2372013751918927179}
  imagePlaceholder: {fileID: 4532812442585639588}
  pageCounterText: {fileID: 1659657190468121947}
  prevButton: {fileID: 9032466260377265346}
  nextButton: {fileID: 3769191492588852299}
  closeButton: {fileID: 298278633542937833}
  fossils:
  - fossilName: "\uD2F0\uB77C\uB178\uC0AC\uC6B0\uB8E8\uC2A4 \uC774\uBE68"
    period: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \xB7 \uC57D 6,800\uB9CC \uB144 \uC804"
    description: "\uC721\uC2DD \uACF5\uB8E1\uC758 \uC774\uBE68\uB85C, \uAC15\uB825\uD55C
      \uD131 \uD798\uC73C\uB85C \uC0AC\uB0E5\uAC10\uC758 \uBF08\uAE4C\uC9C0 \uBD80\uC220
      \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uBC1C\uACAC\uB41C \uC774\uBE68\uC758
      \uAE38\uC774\uB294 \uC57D 15cm\uC774\uBA70, \uD45C\uBA74\uC5D0 \uD1B1\uB2C8
      \uD615\uD0DC\uC758 \uBBF8\uC138\uD55C \uB3CC\uAE30\uAC00 \uBCF4\uC785\uB2C8\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uBD81\uC544\uBA54\uB9AC\uCE74\n\uBD84\uB958: \uC218\uAC01\uB958 \uACF5\uB8E1\n\uD06C\uAE30:
      \uC57D 12\uBBF8\uD130"
    fossilImage: {fileID: 0}
  - fossilName: "\uC554\uBAA8\uB098\uC774\uD2B8"
    period: "\uC950\uB77C\uAE30 \xB7 \uC57D 1\uC5B5 5\uCC9C\uB9CC \uB144 \uC804"
    description: "\uB098\uC120\uD615 \uAECD\uB370\uAE30\uB97C \uAC00\uC9C4 \uB450\uC871\uB958\uB85C,
      \uD604\uC7AC\uC758 \uC624\uC9D5\uC5B4\uC640 \uC720\uC0AC\uD55C \uC0DD\uBB3C\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAECD\uB370\uAE30 \uB0B4\uBD80\uC758 \uAC00\uC2A4 \uC870\uC808\uB85C \uBD80\uB825\uC744
      \uC870\uC808\uD558\uBA70 \uC0B4\uC558\uC2B5\uB2C8\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uC804 \uC138\uACC4 \uBC14\uB2E4\n\uBD84\uB958: \uB450\uC871\uB958\n\uD06C\uAE30:
      \uC57D 5~30cm"
    fossilImage: {fileID: 0}
  - fossilName: "\uC0BC\uC5FD\uCDA9"
    period: "\uACE0\uC0DD\uB300 \uCE84\uBE0C\uB9AC\uC544\uAE30 \xB7 \uC57D 5\uC5B5
      \uB144 \uC804"
    description: "\uCD08\uAE30 \uC808\uC9C0\uB3D9\uBB3C\uC758 \uB300\uD45C \uD654\uC11D\uC73C\uB85C,
      \uB2E8\uB2E8\uD55C \uC678\uACE8\uACA9\uC774 \uD654\uC11D\uC73C\uB85C \uC798
      \uBCF4\uC874\uB429\uB2C8\uB2E4. \uC138 \uAC08\uB798\uB85C \uB098\uB25C \uBAB8
      \uAD6C\uC870\uAC00 \uC774\uB984\uC758 \uC720\uB798\uC785\uB2C8\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uACE0\uB300 \uBC14\uB2E4 \uBC14\uB2E5\n\uBD84\uB958: \uC808\uC9C0\uB3D9\uBB3C\n\uD06C\uAE30:
      \uC57D 3~10cm"
    fossilImage: {fileID: 0}
  - fossilName: "\uD504\uD14C\uB77C\uB178\uB3C8 \uBF08"
    period: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \xB7 \uC57D 8,500\uB9CC \uB144 \uC804"
    description: "\uAC70\uB300 \uC775\uB8E1\uC758 \uACE8\uACA9 \uD654\uC11D\uC785\uB2C8\uB2E4.
      \uAC00\uBCBC\uC6B4 \uC18D\uC774 \uBE48 \uBF08 \uAD6C\uC870\uB85C \uAC70\uB300\uD55C
      \uB0A0\uAC1C\uB97C \uC9C0\uD0F1\uD588\uC2B5\uB2C8\uB2E4. \uBD80\uB9AC\uC5D0\uB294
      \uC774\uBE68\uC774 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC11C\uC2DD\uC9C0: \uBD81\uC544\uBA54\uB9AC\uCE74
      \uD574\uC548\n\uBD84\uB958: \uC775\uB8E1\uB958\n\uB0A0\uAC1C\uD3ED: \uC57D
      7\uBBF8\uD130"
    fossilImage: {fileID: 0}
  - fossilName: "\uBCA8\uB85C\uD0A4\uB78D\uD1A0\uB974 \uBC1C\uD1B1"
    period: "\uBC31\uC545\uAE30 \uD6C4\uAE30 \xB7 \uC57D 7,500\uB9CC \uB144 \uC804"
    description: "\uC791\uC9C0\uB9CC \uC601\uB9AC\uD55C \uC721\uC2DD \uACF5\uB8E1\uC758
      \uAC08\uACE0\uB9AC \uBC1C\uD1B1\uC785\uB2C8\uB2E4. \uC0AC\uB0E5\uAC10\uC744
      \uC81C\uC555\uD558\uB294 \uB370 \uC0AC\uC6A9\uB418\uC5C8\uC73C\uBA70, \uBB34\uB9AC
      \uC0AC\uB0E5\uC744 \uD588\uB2E4\uB294 \uC99D\uAC70\uB3C4 \uBC1C\uACAC\uB429\uB2C8\uB2E4.\n\n\uC11C\uC2DD\uC9C0:
      \uBABD\uACE8\n\uBD84\uB958: \uC218\uAC01\uB958 \uACF5\uB8E1\n\uD06C\uAE30:
      \uC57D 2\uBBF8\uD130"
    fossilImage: {fileID: 0}
  faceCamera: 1
  openDuration: 0.8
